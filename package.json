{
  "name": "shiguang-film",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "electron .",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test": "npm run smoke",
    "smoke": "node tests/camera-smoke.mjs",
    "web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "io.github.semeyd.shiguangfilm",
    "productName": "拾光胶片",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "THIRD_PARTY_NOTICES.md",
      "REFERENCE_LICENSE.txt",
      "defaults.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ShiguangFilm-Setup-${version}-${arch}.${ext}"
    }
  },
  "description": "Local Windows photo album with a 3D film-camera winding interaction",
  "author": "semeyd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semeyd/shiguang-film.git"
  },
  "homepage": "https://github.com/semeyd/shiguang-film",
  "bugs": {
    "url": "https://github.com/semeyd/shiguang-film/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
